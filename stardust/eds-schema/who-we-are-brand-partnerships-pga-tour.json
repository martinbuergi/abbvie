  },
  {
   "section": "band",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "AbbVie Birdies for Brain Health Ambassador"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Gary Woodland, one of the U.S. captain’s assistants for the 2026 Presidents Cup and 2019 U.S. Open champion, will partner with AbbVie to bring Birdies for Brain Health to life through storytelling and engagement. Woodland underwent surgery in 2023 to remove a benign brain lesion and has spoken publicly about the physical, mental and emotional challenges of his recovery."
    }
   ],
   "imgCount": 1,
   "editableTexts": 2,
   "repeats": []
  },
  {
   "section": "quote-band",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "My experience has shown me how important awareness, support and a strong community can be when someone is facing a health challenge. Birdies for Brain Health gives us a meaningful way to use golf’s platform to support organizations advancing science and care, while helping people and care partners know they are not alone."
    },
    {
     "role": "body",
     "order": 1,
     "text": "Gary Woodland"
    },
    {
     "role": "body",
     "order": 2,
     "text": "AbbVie Birdies for Brain Health Ambassador"
    }
   ],
   "imgCount": 1,
   "editableTexts": 1,
   "repeats": []
  },
